// /family/ — VERY IMPORTANT, unlinked. Verbatim birthday message + photo.
func pageFamily() {
    let msg = "I love you so much more than I can ever say. I love you so much, 17 years ago today is the day I got the greatest give in my life that I have received still to this day. I remember you being in the NICU for over a month. When you were a newborn, I would stay at the Ronald McDonald House in Lexington, KY. You were right down the road at the Baptist Hospital. Being able to feed you with tubes and liquid to make sure you are okay. Caring for you in this time to ensure your life would fruition is the one of greatest memories I have with you. I want you to know that I will continue provide for you as long as I live. Son, I love you more than life itself. Please forgive me for the past and keep doing the right thing and following Jesus in your heart and soul! I will tell you something I may have never told you, because I've always called you by your middle name. I gave you James as a first name, because first of all, I knew you would be the perfect man to carry the family name. James came from your Great-Grandfather James Scott, and your Grandfather, James Robert Scott. He has always been the biggest influence beside my mother, and it looks like you are becoming the man that we have all dreamed you would. I trust all the choices that you make now, I'm going to sit here and bawl my tears of joy, I love you son. I know how hard the thing about needing what you need right now. I promise you we will get this straightened out, soon. Your life is about to really start growing at your age, I am so proud of you."
    let content = "<section><div class=" + DQ() + "wrap" + DQ() + "><div class=" + DQ() + "family" + DQ() + ">" +
        "<div class=" + DQ() + "eyebrow" + DQ() + ">For James</div>" +
        htH1("Happy Birthday, James <span class=" + DQ() + "heart" + DQ() + ">&#127874;</span>") +
        "<p class=" + DQ() + "lead" + DQ() + " style=" + DQ() + "max-width:580px;margin:0 auto" + DQ() + ">I love you, you deserve so much more than I have ever been able to give you!</p>" +
        htVoid("img", htSrc("/assets/family-celebration.png") + htAttr("alt", "A warm, celebratory birthday image for James") + htClass("fimg")) +
        "<div class=" + DQ() + "msg" + DQ() + ">" + htP(msg) + "</div>" +
        "</div></div></section>"
    emit privatePage("Happy Birthday James", content)
}

// /team/ — unlinked. Banner image.
func pageTeam() {
    let content = "<section><div class=" + DQ() + "wrap" + DQ() + "><div class=" + DQ() + "prose" + DQ() + " style=" + DQ() + "text-align:center" + DQ() + ">" +
        "<div class=" + DQ() + "eyebrow" + DQ() + ">The people</div>" + htH1("Our Team") +
        "<p class=" + DQ() + "lead" + DQ() + " style=" + DQ() + "margin:0 auto" + DQ() + ">The people behind KryptonBytes.</p>" +
        cimg("/assets/team-members.png", "KryptonBytes team members") +
        "</div></div></section>"
    emit privatePage("Team", content)
}

// /auctions/ — unlinked. Featured image.
func pageAuctions() {
    let content = "<section><div class=" + DQ() + "wrap" + DQ() + "><div class=" + DQ() + "prose" + DQ() + " style=" + DQ() + "text-align:center" + DQ() + ">" +
        "<div class=" + DQ() + "eyebrow" + DQ() + ">Marketplace</div>" + htH1("Auctions") +
        "<p class=" + DQ() + "lead" + DQ() + " style=" + DQ() + "margin:0 auto 6px" + DQ() + ">Items we're currently featuring. " + htA(MAIL, "Contact us") + " to bid or buy.</p>" +
        cimg("/assets/auctions-featured.png", "Featured auction item") +
        "</div></div></section>"
    emit privatePage("Auctions", content)
}

// /careers/ — unlinked. Text.
func pageCareers() {
    let content = "<section><div class=" + DQ() + "wrap" + DQ() + "><div class=" + DQ() + "prose" + DQ() + ">" +
        "<div class=" + DQ() + "eyebrow" + DQ() + ">Join us</div>" + htH1("Careers") +
        htP("We are not hiring at the moment, but we're always exploring future collaborations.") +
        htH3("Areas of interest") +
        htUl(htLi("Modular system design") + htLi("Privacy-first engineering") + htLi("Quantum computing languages") + htLi("Technical consulting for small businesses")) +
        htH3("How to apply") +
        htP("Reach out directly at " + htA(MAIL, "brian@kryptonbytes.com") + ". We keep a talent file and welcome resumes or introductions for future roles and freelance opportunities.") +
        htH3("What we value") +
        htUl(htLi("Ethics and compliance over everything") + htLi("Functionality-first approaches") + htLi("Subsystem-safe workflows") + htLi("Affordable technology solutions") + htLi("Transparent communication") + htLi("Fair compensation")) +
        "</div></div></section>"
    emit privatePage("Careers", content)
}

// /certs-*/ — unlinked. Heading + accolade image.
func pageCert(title, eyebrow, img, alt) {
    let content = "<section><div class=" + DQ() + "wrap" + DQ() + "><div class=" + DQ() + "prose" + DQ() + " style=" + DQ() + "text-align:center" + DQ() + ">" +
        "<div class=" + DQ() + "eyebrow" + DQ() + ">" + eyebrow + "</div>" + htH1(title) +
        cimg(img, alt) +
        "</div></div></section>"
    emit privatePage(title, content)
}

// /privacypolicy/ — linked in footer.
func pagePrivacy() {
    let content = "<section><div class=" + DQ() + "wrap" + DQ() + "><div class=" + DQ() + "prose" + DQ() + ">" +
        "<div class=" + DQ() + "eyebrow" + DQ() + ">Legal</div>" + htH1("Privacy Policy") +
        htH3("1. Information Collected") +
        htP("KryptonBytes may collect the following types of information:") +
        htP(htStrong("Personal Information")) +
        htUl(htLi("Name") + htLi("Email address") + htLi("Phone number") + htLi("Billing information (if applicable)") + htLi("Address for house calls")) +
        htP(htStrong("Technical Information")) +
        htUl(htLi("Device details (for troubleshooting or consulting)") + htLi("System logs or diagnostic data you choose to share") + htLi("Website usage data (if you visit my site)")) +
        htP(htStrong("Business Information")) +
        htUl(htLi("Details about your systems, software, or technical environment") + htLi("Information needed to provide consulting or support services")) +
        htP(htEm("I only collect information that is necessary to deliver my services effectively.")) +
        htH3("2. How Your Information Is Used") +
        htUl(htLi("Providing technical support or consulting services") + htLi("Communicating with you about appointments, updates, or service details") + htLi("Improving my services and customer experience") + htLi("Processing payments (if applicable)") + htLi("Maintaining business records for legal or tax purposes")) +
        htP(htEm("I do not sell or rent your personal information to third parties.")) +
        htH3("3. How Your Information Is Protected") +
        htP("The company takes reasonable steps including secure storage of digital records, limited access to client information, and use of industry-standard security practices. While no system is 100% secure, efforts are made to safeguard information.") +
        htH3("4. Sharing of Information") +
        htUl(htLi("With your permission") + htLi("With service providers who help deliver services") + htLi("When required by law")) +
        htP(htEm("I do not share your information for marketing purposes.")) +
        htH3("5. Data Retention") +
        htP("Information is retained only to provide services, maintain business records, or meet legal obligations. You may request deletion of your information at any time unless I am legally required to retain it.") +
        htH3("6. Your Rights") +
        htUl(htLi("Access to collected information") + htLi("Corrections to inaccurate data") + htLi("Deletion of your information (unless legally restricted)") + htLi("A copy of your data in portable format")) +
        htH3("7. Cookies & Website Tracking") +
        htP("Basic analytics tools may collect non-personal data such as page views, browser type, and device type. You can disable cookies in your browser settings.") +
        htH3("8. Children's Privacy") +
        htP("My services are not directed toward children under 13, and I do not knowingly collect information from minors.") +
        htH3("9. Contact Information") +
        htP("KryptonBytes" + "<br>Email: " + htA(MAIL, "brian@kryptonbytes.com") + "<br>Location: Louisville, Kentucky") +
        "</div></div></section>"
    emit sitePage("Privacy Policy", content)
}

// /tnc/ — linked in footer.
func pageTnc() {
    let content = "<section><div class=" + DQ() + "wrap" + DQ() + "><div class=" + DQ() + "prose" + DQ() + ">" +
        "<div class=" + DQ() + "eyebrow" + DQ() + ">Legal</div>" + htH1("Terms &amp; Conditions") +
        "<p class=" + DQ() + "upd" + DQ() + ">Last updated: Monday, January 26th, 2026</p>" +
        htH3("1. Acceptance of These Terms") +
        htP("By accessing or using this website or any services provided by KryptonBytes, you agree to be bound by these Terms & Conditions. If you do not agree, you must please discontinue use of the site and services.") +
        htH3("2. Services Provided") +
        htP("KryptonBytes offers technical support, consulting, and related IT services. Service descriptions, pricing, and availability may change at any time without notice. All services are provided on a best-effort basis. While we strive for accuracy and reliability, no outcome is guaranteed unless explicitly stated in writing.") +
        htH3("3. Scheduling and Appointments") +
        htP("When booking an appointment through our website:") +
        htUl(htLi("You agree to provide accurate information.") + htLi("You are responsible for ensuring you are available at the scheduled time.") + htLi("We reserve the right to reschedule or decline appointments due to conflicts, emergencies, or misuse of the system.") + htLi("House call services require a valid address within our service area.")) +
        htH3("4. Payments") +
        htP("Unless otherwise stated, all service fees are due at the time of service. Prices listed on the website reflect hourly rates or flat fees and may change without notice. If payment is not completed, we reserve the right to withhold deliverables, documentation, or continued support.") +
        htH3("5. User Responsibilities") +
        htP("You agree not to:") +
        htUl(htLi("misuse the website or scheduling system") + htLi("attempt to disrupt or compromise the site's security") + htLi("submit false, misleading, or harmful information") + htLi("use our services for illegal or unethical purposes")) +
        htP("You are responsible for maintaining the confidentiality of your own devices, accounts, and data.") +
        htH3("6. Intellectual Property") +
        htP("All content on this website — including text, branding, graphics, code, and service descriptions — is the property of KryptonBytes unless otherwise noted. You may not copy, reproduce, or redistribute any content without written permission.") +
        htH3("7. Limitation of Liability") +
        htP("To the fullest extent permitted by law:") +
        htUl(htLi("We are not liable for any indirect, incidental, or consequential damages.") + htLi("We are not responsible for data loss, hardware failure, or third-party issues that occur during or after service.") + htLi("All services are provided as-is without warranties unless explicitly stated.")) +
        htP("You assume all risks associated with implementing technical advice or allowing us to work on your devices or systems.") +
        htH3("8. Third-Party Services") +
        htP("Some services may involve third-party tools, software, or platforms. We are not responsible for the policies, performance, or security of third-party providers.") +
        htH3("9. Website Availability") +
        htP("We do not guarantee uninterrupted access to the website or scheduling system. Maintenance, outages, or technical issues may occur without notice.") +
        htH3("10. Privacy") +
        htP("Your use of this website is also governed by our " + htA("/privacypolicy.html", "Privacy Policy") + ", which explains how we collect, use, and protect your information. The Privacy Policy and these Terms coexist and should be read and considered together.") +
        htH3("11. Changes to These Terms") +
        htP("We may update these Terms at any time. Continued use of the website or services after changes are posted constitutes acceptance of the updated Terms.") +
        htH3("12. Contact Information") +
        htP("For questions about these Terms or your services, contact:<br>Brian with KryptonBytes<br>Email: " + htA(MAIL, "brian@kryptonbytes.com") + "<br>Website: kryptonbytes.com") +
        "</div></div></section>"
    emit sitePage("Terms & Conditions", content)
}

// ── Export ───────────────────────────────────────────────────────────

func writePage(path, html) {
    writeFile(path, html)
    printErr("wrote " + path)
}

just run {
    let dist = "dist"
    writePage(dist + "/index.html", pageHome())
    writePage(dist + "/services.html", pageServices())
    writePage(dist + "/pwnagotchi.html", pagePwnagotchi())
    writePage(dist + "/about.html", pageAbout())
    writePage(dist + "/contact.html", pageContact())
    // Footer-linked legal pages
    writePage(dist + "/privacypolicy.html", pagePrivacy())
    writePage(dist + "/tnc.html", pageTnc())
    // Unlinked (direct-URL only) recreations
    writePage(dist + "/family.html", pageFamily())
    writePage(dist + "/team.html", pageTeam())
    writePage(dist + "/careers.html", pageCareers())
    writePage(dist + "/auctions.html", pageAuctions())
    writePage(dist + "/certs-aiu.html", pageCert("Degrees &amp; Educational Certificates", "AIU", "/assets/cert-aiu-banner.jpg", "AIU degrees and educational certificates"))
    writePage(dist + "/certs-google.html", pageCert("Google Professional &amp; Course Certifications", "Google", "/assets/cert-google.png", "Google certifications"))
    writePage(dist + "/certs-iiba.html", pageCert("IIBA Certifications", "IIBA", "/assets/cert-iiba.png", "IIBA certifications"))
    writePage(dist + "/certs-nasba.html", pageCert("NASBA Recognitions", "NASBA", "/assets/cert-nasba.png", "NASBA recognitions"))
    writePage(dist + "/certs-pmi.html", pageCert("PMI Certificates", "PMI", "/assets/cert-pmi.png", "PMI certificates"))
    printErr("done: 14 pages in " + dist + "/")
}
