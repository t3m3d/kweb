// examples/ksml_todo.htk — a full todo app in pure Krypton via KSML.
//
// Add, toggle, and delete todos with NO hand-written JavaScript. Every
// action is an HTTP request; the server re-renders just the <ul> of todos
// and KSML swaps it into place.
//
// Build + run:
//   KRYPTON_ROOT=. kcc examples/ksml_todo.htk -o ksml_todo
//   ./ksml_todo
//   open http://localhost:8080
//
// State model: todos are kept as newline-separated rows, each row
//   "<done>\t<text>"  where <done> is "0" or "1". Index = row number.

import "k:htmk"
import "k:ksml"
import "k:server"

let todos = ""   // newline list of "done\ttext"
let nextId = 0

func TAB() { emit fromCharCode(9) }
func NL()  { emit fromCharCode(10) }

func startsWith(s, prefix) {
    if len(s) < len(prefix) { emit 0 }
    if substring(s, 0, len(prefix)) == prefix { emit 1 }
    emit 0
}

// ── state helpers ────────────────────────────────────────────────────
func todoAdd(text) {
    if len(text) == 0 { emit todos }
    let row = "0" + TAB() + text
    if len(todos) == 0 { emit row }
    emit todos + NL() + row
}

func todoRowDone(row) {
    let p = indexOf(row, TAB())
    emit substring(row, 0, p)
}
func todoRowText(row) {
    let p = indexOf(row, TAB())
    emit substring(row, p + 1, len(row))
}

// Rebuild the list with row `idx` toggled (done<->not) or deleted.
func todoToggle(idx) {
    let n = lineCount(todos)
    let out = ""
    let i = 0
    while i < n {
        let row = getLine(todos, i)
        if len(row) > 0 {
            let done = todoRowDone(row)
            let text = todoRowText(row)
            if i == idx {
                if done == "0" { done = "1" } else { done = "0" }
            }
            let nr = done + TAB() + text
            if len(out) == 0 { out = nr } else { out = out + NL() + nr }
        }
        i += 1
    }
    emit out
}

func todoDelete(idx) {
    let n = lineCount(todos)
    let out = ""
    let i = 0
    while i < n {
        let row = getLine(todos, i)
        if len(row) > 0 && i != idx {
            if len(out) == 0 { out = row } else { out = out + NL() + row }
        }
        i += 1
    }
    emit out
}

// ── render: just the <ul> of todos (the swap target) ─────────────────
func todoList() {
    let n = lineCount(todos)
    if n == 0 {
        emit htUlA(htId("list"), htLiA(htClass("empty"), "Nothing yet " + fromCharCode(8212) + " add one above."))
    }
    let items = ""
    let i = 0
    while i < n {
        let row = getLine(todos, i)
        if len(row) > 0 {
            let done = todoRowDone(row)
            let text = todoRowText(row)
            let cls = "todo"
            if done == "1" { cls = "todo done" }
            // Toggle by clicking the text; delete via the x button. Both
            // POST and swap the whole <ul#list> back into place.
            let toggleAttrs = ksmlPost("/toggle/" + i) + ksmlTarget("#list") + ksmlSwapOuter()
            let delAttrs    = ksmlPost("/delete/" + i) + ksmlTarget("#list") + ksmlSwapOuter()
            items = items +
                htLiA(htClass(cls),
                    htSpanA(htClass("txt") + toggleAttrs, text) +
                    htButtonA(htClass("x") + delAttrs, fromCharCode(215)))
        }
        i += 1
    }
    emit htUlA(htId("list"), items)
}

// ── full page ────────────────────────────────────────────────────────
func page() {
    let css = htStyle(
        "body{font-family:system-ui,sans-serif;max-width:560px;margin:48px auto;padding:0 16px}" +
        "h1{color:#5d16da}" +
        "form{display:flex;gap:8px;margin:20px 0}" +
        "input[type=text]{flex:1;padding:10px 12px;border:1px solid #ccc;border-radius:8px;font-size:1rem}" +
        "button{padding:10px 18px;border:none;border-radius:8px;background:#7722ff;color:#fff;cursor:pointer}" +
        "button:hover{background:#5d16da}" +
        "ul{list-style:none;padding:0}" +
        "li.todo{display:flex;align-items:center;justify-content:space-between;" +
            "padding:12px 14px;border:1px solid #eee;border-radius:8px;margin:6px 0}" +
        "li.done .txt{text-decoration:line-through;color:#aaa}" +
        ".txt{cursor:pointer;flex:1}" +
        ".x{background:#f2f2f2;color:#c00;padding:4px 10px;font-weight:700}" +
        ".x:hover{background:#fdd}" +
        "li.empty{color:#999;border:none;justify-content:center}"
    )

    // The add form: POST /add, swap the returned <ul> into #list, then
    // clear the input on success (hx-on::after-request handled by runtime).
    let addForm =
        htFormA(
            ksmlPost("/add") + ksmlTarget("#list") + ksmlSwapOuter() +
            htAttr("hx-on::after-request", "this.reset()"),
            htInputA(htType("text") + htName("text") + htPlaceholder("What needs doing?")) +
            htButtonA(htType("submit"), "Add"))

    let body =
        htH1("KSML Todo") +
        htP("A real app in pure Krypton " + fromCharCode(8212) + " no hand-written JavaScript.") +
        addForm +
        todoList()

    emit htPage("KSML Todo", css + ksmlRuntime(), body)
}

// crude form-body parse: "text=do+the+thing" -> "do the thing"
func formValue(body, key) {
    let needle = key + "="
    let p = indexOf(body, needle)
    if p < 0 { emit "" }
    let rest = substring(body, p + len(needle), len(body))
    let amp = indexOf(rest, "&")
    let raw = rest
    if amp >= 0 { raw = substring(rest, 0, amp) }
    // decode + -> space (full urldecode is a stdlib job; spaces cover the demo)
    emit replace(raw, "+", " ")
}

// route "/toggle/3" -> 3
func pathIdx(path, prefix) {
    let rest = substring(path, len(prefix), len(path))
    emit toInt(rest)
}

just run {
    serverInit("8080")
    kp("KSML todo on http://localhost:8080")
    while "1" == "1" {
        let got = serverNext()
        if got == "1" {
            let path = serverReqPath()
            if path == "/add" {
                let text = formValue(serverReqBody(), "text")
                todos = todoAdd(text)
                serverRespond(todoList())
            } else if startsWith(path, "/toggle/") {
                todos = todoToggle(pathIdx(path, "/toggle/"))
                serverRespond(todoList())
            } else if startsWith(path, "/delete/") {
                todos = todoDelete(pathIdx(path, "/delete/"))
                serverRespond(todoList())
            } else {
                serverRespond(page())
            }
        }
    }
}
